# Literal KEY=value settings. No quotes, export, substitutions, or inline comments.
# Paths may contain spaces. Setup copies this template without filling paths.
# REQUIRED: fill both repository paths with resolved absolute checkout directories.
PYFINDER_REPOSITORY=
SHAKEMAP_REPOSITORY=
# REQUIRED: resolved absolute runtime directory inside this deployment checkout.
# Both canonical containers share this parent. Setup never migrates data.
SHAKEMAP_RUNTIME_ROOT=
SHAKEMAP_PORT=9010
SHAKEMAP_MAX_CONCURRENT=10
PYFINDER_SHAKEMAP_ENABLED=false
# REQUIRED before verification/startup: endpoint reachable from the caller container.
# Select the route for your Docker host; verify it before enabling continuous work.
PYFINDER_SHAKEMAP_URL=
PYFINDER_SHAKEMAP_INPUT_DIRECTORY=/home/sysop/runtime/shakemap/data/inputs
PYFINDER_SHAKEMAP_CONFIGURATION=global
PYFINDER_SHAKEMAP_REQUEST_TIMEOUT_SECONDS=30
PYFINDER_SHAKEMAP_OVERWRITE=true
# Optional existing email configuration path inside /home/sysop/runtime/pyfinder.
# Empty disables email; omitting this key preserves legacy file discovery.
# Keep secrets/recipients in the separate file, never in this deployment file.
PYFINDER_ALERT_CONFIG=
